# Copy this file to .env and fill in your own values. Never commit the real .env file.
# Used by ingest_themes.py to write real theme/review data into Supabase.

# Supabase Project Settings -> API -> Project URL
SUPABASE_URL=https://your-project.supabase.co

# Supabase Project Settings -> API -> service_role key (NOT the anon key).
# themes/reviews RLS policies only grant public SELECT, no INSERT — the
# anon key will fail these writes silently.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
