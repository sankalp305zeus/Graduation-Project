# Python
__pycache__/
*.pyc
.venv/
venv/

# Node (outside mvp-shell, which has its own .gitignore)
node_modules/

# data/processed/ is fully regenerable from data/raw/ + the pipeline
# scripts, so it's excluded. data/raw/ is NOT excluded — per the PRD,
# raw scraper output gets committed immediately as disaster insurance
# (re-scraping won't reproduce the exact same review set later).
data/processed/

# Local env files
.env
.env.local
