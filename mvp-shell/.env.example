# Copy to .env.local for local dev. Never commit the real .env.local file.
# On Vercel, set these as Project Environment Variables instead.

# ============================================================
# CLIENT-SIDE — bundled into the browser, safe to expose publicly.
# Vite only exposes vars prefixed VITE_; used by src/supabaseClient.js.
# ============================================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key_here

# ============================================================
# SERVER-SIDE ONLY — read by api/recommend.js (Vercel serverless function).
# NEVER prefix these with VITE_ — that would bundle them into client-side
# JS and expose them to anyone viewing the page source.
# ============================================================

# Same project URL as VITE_SUPABASE_URL above, but read server-side by
# api/recommend.js via process.env.SUPABASE_URL (no VITE_ prefix there).
SUPABASE_URL=https://your-project.supabase.co

# Supabase Project Settings -> API -> service_role key (NOT the anon key).
# themes/reviews RLS policies only grant public SELECT, no INSERT — the
# service role key is required for recommend.js and ingest_themes.py to
# write real theme data; the anon key will fail those writes silently.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# console.groq.com -> API Keys. Used by api/recommend.js for the live
# recommendation call (see docs/GROQ_MIGRATION_AND_FAILPROOFING.md).
GROQ_API_KEY=your_groq_api_key_here
